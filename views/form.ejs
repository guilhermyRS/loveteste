<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'sans': ['Poppins', 'sans-serif'],
            'script': ['"Dancing Script"', 'cursive'],
          },
          colors: {
            'love-red': '#e94057',
            'love-pink': '#f27121',
            'love-purple': '#8a2387',
          }
        }
      }
    }
  </script>
  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #8a2387, #e94057, #f27121);
    }
    .form-gradient {
      background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.8));
    }
  </style>
</head>
<body class="min-h-screen gradient-bg">
  <div class="container mx-auto px-4 py-8">
    <header class="text-center mb-8">
      <h1 class="text-4xl md:text-5xl font-script font-bold text-white mb-4">Eternize Seu Amor</h1>
      <p class="text-white text-lg md:text-xl">Crie uma página especial para celebrar sua história de amor</p>
    </header>

    <div class="max-w-3xl mx-auto bg-white rounded-lg shadow-xl overflow-hidden">
      <div class="p-6 md:p-8">
        <% if (error) { %>
          <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded" role="alert">
            <p class="font-medium">Erro</p>
            <p><%= error %></p>
          </div>
        <% } %>

        <form action="/criar" method="POST" enctype="multipart/form-data" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="nome1" class="block text-sm font-medium text-gray-700 mb-1">Seu Nome</label>
              <input type="text" name="nome1" id="nome1" placeholder="Ex: Maria" value="<%= formData?.nome1 || '' %>" required
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-love-red">
            </div>
            
            <div>
              <label for="nome2" class="block text-sm font-medium text-gray-700 mb-1">Nome do Parceiro(a)</label>
              <input type="text" name="nome2" id="nome2" placeholder="Ex: João" value="<%= formData?.nome2 || '' %>" required
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-love-red">
            </div>
          </div>

          <div>
            <label for="texto" class="block text-sm font-medium text-gray-700 mb-1">Sua Declaração de Amor</label>
            <textarea name="texto" id="texto" placeholder="Escreva sua mensagem de amor aqui..." rows="5" required
              class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-love-red"><%= formData?.texto || '' %></textarea>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="data_inicio" class="block text-sm font-medium text-gray-700 mb-1">Data de Início do Relacionamento</label>
              <input type="date" name="data_inicio" id="data_inicio" value="<%= formData?.data_inicio || '' %>" required
                class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-love-red">
            </div>
            
            <div>
              <label for="slug" class="block text-sm font-medium text-gray-700 mb-1">URL Personalizada</label>
              <div class="flex items-center">
                <span class="text-gray-500 bg-gray-100 px-3 py-2 rounded-l-md border border-r-0 border-gray-300">nossa-historia.com/</span>
                <input type="text" name="slug" id="slug" placeholder="nosso-amor" value="<%= formData?.slug || '' %>" required
                  class="flex-1 px-4 py-2 border border-gray-300 rounded-r-md focus:outline-none focus:ring-2 focus:ring-love-red">
              </div>
              <p class="text-xs text-gray-500 mt-1">Use apenas letras minúsculas, números e hífens</p>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">Escolha o Layout</label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <label class="relative border-2 rounded-lg p-4 cursor-pointer transition-all hover:shadow-md <%= formData?.layout === 'carta' ? 'border-love-red bg-love-red/10' : 'border-gray-200' %>">
                <input type="radio" name="layout" value="carta" class="absolute top-4 left-4 w-5 h-5 accent-love-red" <%= formData?.layout === 'carta' ? 'checked' : '' %> required>
                <div class="flex items-center pl-6">
                  <div class="w-12 h-12 flex items-center justify-center bg-love-red/10 rounded-full mr-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-love-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <div>
                    <span class="block font-medium">Carta de Amor</span>
                    <span class="text-sm text-gray-500">Estilo romântico e clássico (3 imagens)</span>
                  </div>
                </div>
              </label>
              
              <label class="relative border-2 rounded-lg p-4 cursor-pointer transition-all hover:shadow-md <%= formData?.layout === 'netflix' ? 'border-love-red bg-love-red/10' : 'border-gray-200' %>">
                <input type="radio" name="layout" value="netflix" class="absolute top-4 left-4 w-5 h-5 accent-love-red" <%= formData?.layout === 'netflix' ? 'checked' : '' %> required>
                <div class="flex items-center pl-6">
                  <div class="w-12 h-12 flex items-center justify-center bg-love-red/10 rounded-full mr-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-love-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                    </svg>
                  </div>
                  <div>
                    <span class="block font-medium">Estilo Netflix</span>
                    <span class="text-sm text-gray-500">Moderno e cinematográfico (5 imagens)</span>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">Escolha o Tema</label>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
              <label class="relative border-2 rounded-lg p-3 cursor-pointer transition-all hover:shadow-md <%= !formData?.theme || formData?.theme === 'default' ? 'border-love-red' : 'border-gray-200' %>">
                <input type="radio" name="theme" value="default" class="absolute top-2 right-2 w-4 h-4 accent-love-red" <%= !formData?.theme || formData?.theme === 'default' ? 'checked' : '' %>>
                <div class="h-8 rounded bg-gradient-to-r from-love-purple via-love-red to-love-pink"></div>
                <p class="text-center text-sm mt-2">Romântico</p>
              </label>
              
              <label class="relative border-2 rounded-lg p-3 cursor-pointer transition-all hover:shadow-md <%= formData?.theme === 'ocean' ? 'border-love-red' : 'border-gray-200' %>">
                <input type="radio" name="theme" value="ocean" class="absolute top-2 right-2 w-4 h-4 accent-love-red" <%= formData?.theme === 'ocean' ? 'checked' : '' %>>
                <div class="h-8 rounded bg-gradient-to-r from-blue-500 via-teal-400 to-cyan-300"></div>
                <p class="text-center text-sm mt-2">Oceano</p>
              </label>
              
              <label class="relative border-2 rounded-lg p-3 cursor-pointer transition-all hover:shadow-md <%= formData?.theme === 'sunset' ? 'border-love-red' : 'border-gray-200' %>">
                <input type="radio" name="theme" value="sunset" class="absolute top-2 right-2 w-4 h-4 accent-love-red" <%= formData?.theme === 'sunset' ? 'checked' : '' %>>
                <div class="h-8 rounded bg-gradient-to-r from-orange-500 via-amber-500 to-yellow-300"></div>
                <p class="text-center text-sm mt-2">Pôr do Sol</p>
              </label>
              
              <label class="relative border-2 rounded-lg p-3 cursor-pointer transition-all hover:shadow-md <%= formData?.theme === 'forest' ? 'border-love-red' : 'border-gray-200' %>">
                <input type="radio" name="theme" value="forest" class="absolute top-2 right-2 w-4 h-4 accent-love-red" <%= formData?.theme === 'forest' ? 'checked' : '' %>>
                <div class="h-8 rounded bg-gradient-to-r from-green-700 via-green-500 to-lime-300"></div>
                <p class="text-center text-sm mt-2">Floresta</p>
              </label>
              
              <label class="relative border-2 rounded-lg p-3 cursor-pointer transition-all hover:shadow-md <%= formData?.theme === 'dark' ? 'border-love-red' : 'border-gray-200' %>">
                <input type="radio" name="theme" value="dark" class="absolute top-2 right-2 w-4 h-4 accent-love-red" <%= formData?.theme === 'dark' ? 'checked' : '' %>>
                <div class="h-8 rounded bg-gradient-to-r from-gray-900 via-gray-700 to-gray-800"></div>
                <p class="text-center text-sm mt-2">Escuro</p>
              </label>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">Imagens do Casal</label>
            <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center">
              <input type="file" name="imagens" id="imagens" multiple accept="image/*" required
                class="hidden" onchange="updateFileNames()">
              <label for="imagens" class="cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="mt-2 text-sm text-gray-600">Clique para selecionar imagens ou arraste e solte aqui</p>
                <p class="mt-1 text-xs text-gray-500">Carta: 3 imagens | Netflix: 5 imagens</p>
              </label>
              <div id="file-names" class="mt-3 text-sm text-gray-500"></div>
            </div>
          </div>

          <div class="flex justify-center">
            <button type="submit" class="px-8 py-3 bg-gradient-to-r from-love-purple via-love-red to-love-pink text-white font-medium rounded-md shadow-md hover:shadow-lg transition-all transform hover:-translate-y-1">
              Criar Nossa História
            </button>
          </div>
        </form>
      </div>
    </div>

    <footer class="mt-12 text-center text-white">
      <p>Eternize seu amor e compartilhe com quem você ama ❤️</p>
      <p class="mt-2 text-sm opacity-75">© 2024 Nossa História de Amor</p>
    </footer>
  </div>

  <script>
    function updateFileNames() {
      const input = document.getElementById('imagens');
      const fileNames = document.getElementById('file-names');
      
      if (input.files.length > 0) {
        fileNames.innerHTML = '';
        for (let i = 0; i < input.files.length; i++) {
          fileNames.innerHTML += `<div class="text-left"><span class="font-medium">Imagem ${i+1}:</span> ${input.files[i].name}</div>`;
        }
      } else {
        fileNames.innerHTML = '';
      }
    }

    // Update layout requirements based on selection
    document.querySelectorAll('input[name="layout"]').forEach(radio => {
      radio.addEventListener('change', function() {
        const fileText = document.querySelector('#imagens + label p:nth-child(3)');
        if (this.value === 'carta') {
          fileText.textContent = 'Carta: 3 imagens | Netflix: 5 imagens';
        } else if (this.value === 'netflix') {
          fileText.textContent = 'Carta: 3 imagens | Netflix: 5 imagens';
        }
      });
    });
  </script>
</body>
</html>
